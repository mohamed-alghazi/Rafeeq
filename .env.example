# Add your own key locally; never commit .env.
OPENROUTER_API_KEY=
RAFEEQ_MODEL=openrouter/free
# Optional private-session API code; browser visitors use Start demo without a code. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
RAFEEQ_ACCESS_TOKEN=
# Optional OpenAI alternative: set OPENAI_API_KEY and RAFEEQ_PROVIDER=openai
RAFEEQ_PROVIDER=openrouter
